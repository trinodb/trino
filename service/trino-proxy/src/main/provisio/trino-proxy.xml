<runtime>
    <archive name="${project.artifactId}-${project.version}.tar.gz" streaming="true" />

    <fileSet to="/">
        <directory path="${basedir}">
            <include>README.txt</include>
        </directory>
    </fileSet>

    <artifactSet to="bin">
        <artifact id="io.airlift:launcher:tar.gz:bin:${dep.launcher.version}">
            <unpack />
        </artifact>
        <artifact id="io.airlift:launcher:tar.gz:properties:${dep.launcher.version}">
            <unpack filter="true" />
        </artifact>
    </artifactSet>

    <artifactSet to="lib" ref="runtime.classpath" />
</runtime>
